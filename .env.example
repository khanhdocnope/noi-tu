# ============================================================
# ECHO — Environment Variables
# Copy file này thành .env và điền giá trị thực.
# ============================================================

# ── Discord ──────────────────────────────────────────────────
# Token Discord Bot (từ Discord Developer Portal)
DISCORD_TOKEN=your_bot_token_here

# Guild ID (Server ID) — Nếu set, commands chỉ đăng ký cho server này
# Nếu bỏ trống → commands đăng ký global
guildId=

# ── Privileged Users ─────────────────────────────────────────
# Danh sách User IDs được phép dùng lệnh privileged
# Format: ID1,ID2,ID3 (phân tách bằng dấu phẩy)
# Nếu bỏ trống → ai cũng dùng được (dev mode)
ALLOWED_USERS=1200389149409153078

# ── Database ─────────────────────────────────────────────────
# Đường dẫn file SQLite (mặc định: ./data/echo.db)
# DB_PATH=./data/echo.db
